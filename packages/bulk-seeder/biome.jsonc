{
	"root": false,
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"javascript": {
		"formatter": {
			"quoteProperties": "asNeeded",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"index.ts",
			"**/*.ts",
			"!**/node_modules/**/*",
			"!**/dist/**/*"
		]
	}
}
