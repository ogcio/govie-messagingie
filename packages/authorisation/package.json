{
  "name": "@ogcio/authorisation",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api/*": {
      "types": "./dist/api/*.d.ts",
      "import": "./dist/api/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@logto/next": "3.5.0",
    "@logto/node": "2.5.5",
    "jose": "6.2.2"
  },
  "devDependencies": {},
  "peerDependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.prod.json",
    "test": "vitest run --coverage --reporter=junit --outputFile=results.xml",
    "test:watch": "vitest",
    "format": "biome check --write",
    "lint": "biome check"
  }
}
