{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2017"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/test/**", "node_modules", "dist"]
}
