{
  "root": false,
  "extends": ["../../biome.jsonc"],
  "files": {
    "includes": [
      "src/**/*.ts",
      "db/*.js",
      "db/**/*.json",
      "k6/**/*.js",
      "k6/**/*.mjs",
      "*.json",
      "*.jsonc",
      "*.mts"
    ]
  },
  "javascript": {
    "formatter": {
      "semicolons": "always"
    }
  }
}
