meta {
  name: Citizen can download the shared file
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/files/:fileId
  body: none
  auth: none
}

params:path {
  fileId: {{fileId}}
}

headers {
  Authorization: Bearer {{citizenAccessToken}}
}

assert {
  ~res.headers["content-type"]: eq text/plain
  ~res.status: eq 200
}

docs {
  Citizen not returning the correct scope to access this endpoint
}
