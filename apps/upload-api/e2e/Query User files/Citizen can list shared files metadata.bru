meta {
  name: Citizen can list shared files metadata
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/metadata?userId={{process.env.CITIZEN_USER_PROFILE_ID}}
  body: none
  auth: none
}

params:query {
  userId: {{process.env.CITIZEN_USER_PROFILE_ID}}
}

headers {
  Authorization: Bearer {{citizenAccessToken}}
}

assert {
  ~res.body.data[0].id: eq {{fileId}}
  ~res.body.data.length: eq 1
}

docs {
  Citizen not returning the correct scope to access this endpoint
}
