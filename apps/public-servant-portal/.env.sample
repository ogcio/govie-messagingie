NEXT_PUBLIC_BASE_URL=http://messaging-admin.local.test:4002
NEXT_PUBLIC_MESSAGING_URL=http://messaging.local.test:4001
NEXT_PUBLIC_PROFILE_ADMIN_URL=http://profile-admin.local.test:4002
NEXT_PUBLIC_MESSAGING_ADMIN_URL=http://messaging-admin.local.test:4002
# SAG dev is configured with SESSION_COOKIE_DOMAIN=.local.test, so the
# round-trip cookies it sets on /auth/sign-in (logto_app, logto_redirect)
# are scoped to the shared `.local.test` parent. Callers MUST reach SAG
# on a `.local.test` hostname — using bare `localhost` here makes the
# browser reject the Set-Cookie (RFC 6265 §5.3: request host must
# domain-match the cookie's Domain attribute), the Logto callback then
# arrives at sag.local.test:3333 with no cookies and SAG replies 400
# APP_REQUIRED. Matches citizen-portal .env.sample. Requires
# `sag.local.test` in /etc/hosts alongside the two admin hostnames the
# README lists.
NEXT_PUBLIC_SAG_URL=http://sag.local.test:3333
NEXT_PUBLIC_PROFILE_URL=http://profile.local.test:4001

# --- Matomo (optional — same IDs as legacy messaging ANALYTICS_*; omit to disable client tracker)
# Production Docker sets NEXT_PUBLIC_ANALYTICS_URL to <NEXT_PUBLIC_BASE_URL>/_next/analytics-api (nginx proxies to ANALYTICS_MANAGEMENT_API_* from the image build; avoids CORS).
# Local next dev: optional override for the /_next/analytics-api rewrite target (default: https://api.analytics.dev.services.gov.ie)
# ANALYTICS_MANAGEMENT_API_ORIGIN=https://api.analytics.dev.services.gov.ie
# Local: with MATOMO_* below, the app uses http://localhost:3002/_next/analytics-api — `next dev` rewrites that path to analytics (see next.config.ts).
# NEXT_PUBLIC_ANALYTICS_URL=https://messaging.dev.services.gov.ie/_next/analytics-api
# Or protocol + host (resolved via same-origin proxy as above):
# NEXT_PUBLIC_MATOMO_PROTOCOL=https
# NEXT_PUBLIC_MATOMO_URL=//analytics.ogcio.gov.ie
# NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=3e96e2f2-04a3-5576-e168-752846f4515b
# NEXT_PUBLIC_ANALYTICS_ORGANIZATION_ID=ogcio
# NEXT_PUBLIC_ANALYTICS_DRY_RUN=true

# --- Feature Flags (leave blank unless Unleash is running locally)
NEXT_PUBLIC_UNLEASH_URL=
NEXT_PUBLIC_UNLEASH_CLIENT_KEY=
NEXT_PUBLIC_UNLEASH_APP_NAME=public-servant-portal

# --- Observability
NEXT_PUBLIC_FARO_URL=
NEXT_PUBLIC_FARO_SERVICE_NAME=public-servant-portal
NEXT_PUBLIC_FARO_SERVICE_NAMESPACE=messaging
NEXT_PUBLIC_FARO_PROPAGATE_TRACE_HEADER=http://localhost:3002/*

OTEL_ENABLE=false
OTEL_SERVICE_NAME=
OTEL_COLLECTOR_URL=
PORT=3002
