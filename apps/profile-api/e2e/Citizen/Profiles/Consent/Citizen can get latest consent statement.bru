meta {
  name: Citizen can get latest consent statement
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/citizens/consent-statements/current?subject=messaging
  body: none
  auth: bearer
}

params:query {
  subject: messaging
}

auth:bearer {
  token: {{citizenAccessToken}}
}

body:json {
  {
    "subject": "messaging",
    "status": "pending"
  }
}

vars:post-response {
  currentConsentStatementId: res.body.data[0].translations.en.consentStatementId
}

assert {
  res.status: eq 200
}
