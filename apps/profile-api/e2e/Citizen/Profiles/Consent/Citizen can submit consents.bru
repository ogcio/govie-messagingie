meta {
  name: Citizen can submit consents
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/citizens/consents
  body: json
  auth: bearer
}

auth:bearer {
  token: {{citizenAccessToken}}
}

body:json {
  {
    "consents": [
      {
        "subject": "messaging",
        "status": "opted-in",
        "consentStatementId": "{{currentConsentStatementId}}"
      }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.data: length 1
  res.body.data[0].subject: eq "messaging"
  res.body.data[0].status: eq "opted-in"
  res.body.data[0].isLatestStatement: eq true
}
