meta {
  name: Public Servant Can Get Any Profile
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/profiles/:profileId
  body: none
  auth: bearer
}

params:path {
  profileId: {{profileId}}
}

auth:bearer {
  token: {{accessToken}}
}

vars:post-response {
  profileLastName: res.body.data ?  res.body.data.details.lastName : undefined
}

assert {
  res.status: eq 200
  res.body.data.email: eq {{citizenEmail}}
}
