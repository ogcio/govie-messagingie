meta {
  name: Get Support Token
  type: http
  seq: 1
  tags: [
    announcements
  ]
}

post {
  url: {{logtoApiUrl}}/oidc/token
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
  Authorization: Basic {{process.env.BRUNO_SUPPORT_BASIC_M2M_TOKEN}}
}

body:form-urlencoded {
  grant_type: client_credentials
  scope: {{scopes}}
  resource: internal://platform-admin
}

vars:pre-request {
  scopes: platform:profile:read platform:profile:write
}

vars:post-response {
  supportAccessToken: res.body.access_token
}
