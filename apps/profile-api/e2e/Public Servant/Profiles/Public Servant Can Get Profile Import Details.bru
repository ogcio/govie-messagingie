meta {
  name: Public Servant Can Get Profile Import Details
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/profiles/imports/{{importId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.data: isDefined
  res.body.data.details[0].firstName: isDefined
  res.body.data.details[0].lastName: isDefined
  res.body.data.details[0].email: isDefined
  res.body.data.details[0].preferredLanguage: isDefined
}
