{
  "root": false,
  "extends": ["../../biome.jsonc"],
  "files": {
    "includes": [
      "**/*",
      "!**/.*/**/*",
      "!**/node_modules/**/*",
      "!**/dist/**/*",
      "!**/coverage/**/*"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteProperties": "asNeeded",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
