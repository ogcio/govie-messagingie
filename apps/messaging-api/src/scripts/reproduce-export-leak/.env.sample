# reproduce-export-leak - environment variables (names only; fill in real values)
#
# SAFETY: this task mutates real data in the target environment. Use dev/uat and
# throwaway test accounts ONLY. The script refuses to run if NODE_ENV=production
# or if REPRO_ENV / any resolved host looks production-like (matches /prod|prd/),
# and every mutating subcommand additionally requires --yes (or REPRO_CONFIRM=yes).
#
# ---- RECOMMENDED DEFAULT SETUP (dev/uat) --------------------------------------
# Org / sending identity: organization "first-testing", app "M2M E2E Tester".
#   - E2E Tester app id (dev/uat/testing): treftr21fgbvsdjwlol9
#     (the local seed uses qrtllp45fgbvsdjyasd5 instead)
#   - Org token scopes: messaging:message:*  upload:file:*  profile:user:read
#     (the E2E Tester app also carries profile:user.admin:* and upload:file:*)
# One E2E Tester app fills all three org-credential slots below.
#
# Recipients:
#   - user1 (EXPORTER / leak RECIPIENT): andrea - a real MyGovID account that
#     logs into the citizen portal to verify the leak MANUALLY (see README). His
#     export ends up containing user2's file. Profile ids differ per env:
#       dev: andrea.pregnolato+testdev@nearform.com  profileId 86yzcekv9bte
#       uat: andrea.pregnolato@pm.me                  profileId ybogyi9hneb7
#   - user2 (owner of the leaked file): e2e_citizen_user_2 - verified clean (no
#     pre-existing org import or files) in dev AND uat.
#       profileId e2e-cit-2  email e2e_citizen_2@user.com  PPSN E2E_CITIZEN_USER_2
#
# Where to get the E2E Tester secret (NEVER commit it - use a placeholder here):
#   - dev: profile repo Bruno env file
#          @ogcio/govie-services-profile/apps/profile-api/e2e/.env.dev
#   - uat: the UAT block in @ogcio/govie-services-profile/apps/profile-api/e2e/.env
#     (both expose a Basic token for app treftr21fgbvsdjwlol9)
#   - in cluster: AWS Secrets Manager workloads/logto/<env> property
#          SEEDER_M2M_E2E_TESTER_APP_SECRET

# ---- Environment selection ----------------------------------------------------
# Either set REPRO_ENV to a known environment (dev|uat) ...
REPRO_ENV=dev
# ... OR provide explicit base URLs (these take precedence over REPRO_ENV):
REPRO_UPLOAD_BASE_URL=
REPRO_MESSAGING_BASE_URL=
REPRO_PROFILE_BASE_URL=
REPRO_LOGTO_OIDC_ENDPOINT=

# ---- Organisation-scoped M2M credentials (seed + cleanup) ---------------------
# Client-credentials ORG tokens. With the M2M E2E Tester the same app id/secret
# fills all three slots. Required scopes per slot:
#   profile   -> profile:user:read      (only calls findProfile if a recipient is
#                                         supplied as an email; then needs
#                                         profile:user.admin:*)
#   messaging -> messaging:message:*    (messaging.send)
#   upload    -> upload:file:*          (uploadFile / shareFile / removeFileSharing)
REPRO_ORGANIZATION_ID=first-testing
REPRO_MESSAGING_M2M_APP_ID=treftr21fgbvsdjwlol9
REPRO_MESSAGING_M2M_APP_SECRET=CHANGE_ME
REPRO_UPLOAD_M2M_APP_ID=treftr21fgbvsdjwlol9
REPRO_UPLOAD_M2M_APP_SECRET=CHANGE_ME
REPRO_PROFILE_M2M_APP_ID=treftr21fgbvsdjwlol9
REPRO_PROFILE_M2M_APP_SECRET=CHANGE_ME

# ---- Target users + confirmation ----------------------------------------------
# If a value contains "@" it is resolved via profile.findProfile (which needs
# profile:user.admin:*); otherwise it is used directly as a profileId. Defaults
# (applied if unset) - user1 (andrea) differs per env, user2 is the same:
#   dev  user1 -> 86yzcekv9bte   (andrea.pregnolato+testdev@nearform.com)
#   uat  user1 -> ybogyi9hneb7   (andrea.pregnolato@pm.me)
#   user2 -> e2e-cit-2  (e2e_citizen_user_2, owner of the leaked file)
# Example below is for REPRO_ENV=dev; use ybogyi9hneb7 for uat.
REPRO_USER1=86yzcekv9bte
REPRO_USER2=e2e-cit-2
# Alternative to the --yes flag for mutating subcommands.
REPRO_CONFIRM=
