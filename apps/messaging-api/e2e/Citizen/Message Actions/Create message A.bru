meta {
  name: Create message A
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/messages
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
    {
      "preferredTransports": ["email"],
      "recipientUserId": "{{process.env.CITIZEN_USER_PROFILE_ID}}",
      "security": "confidential",
      "bypassConsent": true,
      "scheduleAt": "2025-11-12T10:05:04.865Z",
      "message": {
        "threadName": "threadName",
        "subject": "Message Subject",
        "excerpt": "excerpt",
        "plainText": "plainText",
        "richText": "richText",
        "language": "en"
      }
  }
  
}

vars:post-response {
  messageAId: res.body.data.id
}

assert {
  res.status: eq 201
  res.body: isJson
}
