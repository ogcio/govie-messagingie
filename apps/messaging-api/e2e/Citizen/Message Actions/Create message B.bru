meta {
  name: Create message B
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/messages
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
    {
      "preferredTransports": ["email"],
      "recipientUserId": "{{process.env.CITIZEN_USER_PROFILE_ID}}",
      "security": "public",
      "bypassConsent": false,
      "scheduleAt": "2026-08-06T05:05:04.865Z",
      "message": {
        "threadName": "threadName",
        "subject": "messageSubject",
        "excerpt": "excerpt",
        "plainText": "plainText",
        "richText": "richText",
        "language": "en"
      }
  }
}

vars:post-response {
  messageBId: res.body.data.id
  messageBId2: res.body.data.id
}

assert {
  res.status: eq 201
  res.body: isJson
}
