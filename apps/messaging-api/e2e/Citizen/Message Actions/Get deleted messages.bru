meta {
  name: Get deleted messages
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/messages/?deletedAfterDateTime=2025-10-26T10:05:04.865Z
  body: none
  auth: bearer
}

params:query {
  deletedAfterDateTime: 2025-10-26T10:05:04.865Z
}

auth:bearer {
  token: {{citizenAccessToken}}
}

vars:post-response {
  messageId: res.body.data && res.body.data[0] ?  res.body.data[0].id : undefined
}

assert {
  res.status: eq 200
}

tests {
  test("should contain deleted id", function(){
    const body = res.getBody()
    const deletedItem = body.data.find(item => item.id === bru.getEnvVar("messageBId2"))
    expect(deletedItem).equals(bru.getEnvVar("messageBId2"))
  })
}
