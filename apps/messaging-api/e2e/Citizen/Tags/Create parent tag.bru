meta {
  name: Create parent tag
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/tags
  body: json
  auth: bearer
}

auth:bearer {
  token: {{citizenAccessToken}}
}

body:json {
  {
    "label": "{{parentTagName}}"
  }
}

vars:post-response {
  parentTagId: res.body.data && res.body.data ?  res.body.data.id : undefined
}

assert {
  res.status: eq 201
  res.body.data: isDefined
  res.body.data.id: isDefined
}

script:pre-request {
  const suffix = require("uuid").v4().substring(0,5)
  const name = `Parent ${suffix}`;
  bru.setVar('parentTagName', name);
}
