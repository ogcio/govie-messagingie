meta {
  name: Delete template2
  type: http
  seq: 15
}

delete {
  url: {{baseUrl}}/api/v1/templates/{{templateId2}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
}

script:pre-request {
  const baseUrl = bru.getEnvVar("baseUrl")
  const templateId = bru.getEnvVar("templateId2")
  console.log("deleting url id to ", templateId)
  req.setUrl(`${baseUrl}/api/v1/templates/${templateId}`)
}

docs {
  Cleans up all created templates
}
