meta {
  name: Find created message event
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/message-events?search={{messageSubject}}
  body: none
  auth: bearer
}

params:query {
  search: {{messageSubject}}
}

auth:bearer {
  token: {{accessToken}}
}

vars:post-response {
  eventId: res.body.data.at(0).id
  sentMessageId: res.body.data.at(0).messageId
  messageSubject: res.body.data.at(0).subject
}

assert {
  res.body: isJson
  res.status: eq 200
}
