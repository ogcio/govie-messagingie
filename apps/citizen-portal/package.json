{
  "name": "citizen-portal",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "PORT=4001 next dev",
    "build": "next build",
    "build:prod": "node scripts/build-with-prod-tsconfig.mjs",
    "start": "npx serve out -p 4001",
    "typegen": "next typegen",
    "format": "biome check --write",
    "lint": "biome check",
    "test": "vitest run --coverage --reporter=junit --outputFile=results.xml || exit 0",
    "test:local": "vitest",
    "test:browser": "vitest --browser",
    "test:k6:docker": "/bin/bash k6/run_all_routes_with_stats.sh",
    "test:k6:baseline": "k6 run k6/tests/baseline.ts",
    "test:k6:load": "k6 run k6/tests/load-test.ts",
    "test:k6:compare": "k6 run k6/tests/comparison.ts",
    "test:k6:all": "k6 run k6/tests/baseline.ts && k6 run k6/tests/load-test.ts",
    "test:k6:route:messages": "k6 run -e ROUTE=messages k6/tests/single-route.ts",
    "test:e2e:local": "BASE_URL=http://messaging.local.test:8080 playwright test",
    "test:e2e:smoke:local": "BASE_URL=http://messaging.local.test:8080 playwright test e2e/smoke --workers 1",
    "test:e2e:local:smoke": "BASE_URL=http://messaging.local.test:8080 playwright test e2e/smoke --workers 1",
    "test:e2e:local:full": "BASE_URL=http://messaging.local.test:8080 ADMIN_URL=http://messaging.local.test:8080 E2E_AUTH_URL=http://authorization.local.test:8080/sign-in RUN_CROSS_ZONE_E2E=1 MESSAGING_HOST=http://messaging.local.test:8080 PROFILE_HOST=http://profile.local.test:8080 DASHBOARD_HOST=http://dashboard.local.test:8080 playwright test --workers 1",
    "test:e2e:flags:local": "CITIZEN_PORTAL_FLAGS_E2E=1 E2E_AUTH_URL=http://authorization.local.test:8080/sign-in playwright test --config=playwright.flags.config.ts --workers 1",
    "test:e2e:dev": "BASE_URL=https://messaging.dev.services.gov.ie  ADMIN_URL=https://messaging-admin.dev.services.gov.ie  DASHBOARD_URL=https://dashboard.dev.services.gov.ie PROFILE_URL=https://profile.dev.services.gov.ie AUTH_URL=https://authorization.dev.services.gov.ie/sign-in MOCK_URL=https://mock-login-service.dev.services.gov.ie playwright test  --workers 1",
    "test:e2e:dev:ui": "npm run test:e2e:dev -- --ui",
    "record:message-detail-demo": "playwright test --config=playwright.demo.config.ts",
    "test:smoke:e2e": "BASE_URL=https://messaging.dev.services.gov.ie  ADMIN_URL=https://messaging-admin.dev.services.gov.ie DASHBOARD_URL=https://dashboard.dev.services.gov.ie PROFILE_URL=https://profile.dev.services.gov.ie AUTH_URL=https://authorization.dev.services.gov.ie/sign-in MOCK_URL=https://mock-login-service.dev.services.gov.ie playwright test --grep '@smoke' --workers 1",
    "test:regression:e2e": "BASE_URL=https://messaging.dev.services.gov.ie  ADMIN_URL=https://messaging-admin.dev.services.gov.ie  DASHBOARD_URL=https://dashboard.dev.services.gov.ie PROFILE_URL=https://profile.dev.services.gov.ie AUTH_URL=https://authorization.dev.services.gov.ie/sign-in MOCK_URL=https://mock-login-service.dev.services.gov.ie playwright test --grep '@regression|@smoke|@visual' --workers 1",
    "docker:compose:up": "docker compose up -d citizen-portal",
    "docker:compose:up:full": "docker compose -f docker-compose.yaml -f docker-compose.local-auth.yaml up -d",
    "docker:compose:down:full": "docker compose -f docker-compose.yaml -f docker-compose.local-auth.yaml down",
    "seed:local-logto": "node ../../scripts/dev/seed-local-logto.mjs"
  },
  "dependencies": {
    "@citizen-portal/shared": "workspace:*",
    "@formatjs/intl-localematcher": "0.8.12",
    "@grafana/faro-core": "2.8.2",
    "@grafana/faro-instrumentation-replay": "2.8.2",
    "@grafana/faro-web-sdk": "2.8.2",
    "@js-temporal/polyfill": "0.5.1",
    "@ogcio/analytics-sdk": "0.2.14",
    "@ogcio/announcements": "0.3.0",
    "@ogcio/consent": "1.5.0",
    "@ogcio/design-system-react": "1.41.0",
    "@ogcio/nextjs-analytics": "1.0.1",
    "@ogcio/o11y-sdk-react": "0.12.0",
    "@ogcio/sag-client": "0.7.5",
    "@ogcio/theme-govie": "1.21.7",
    "@tanstack/react-table": "8.21.3",
    "@unleash/proxy-client-react": "6.0.0",
    "next": "16.2.10",
    "next-intl": "4.13.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "swr": "2.4.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.10",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/k6": "2.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "axe-html-reporter": "2.2.11",
    "gmail-getter": "2.4.0",
    "jsdom": "29.1.1",
    "vitest": "4.1.10"
  }
}
