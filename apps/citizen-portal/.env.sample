# Consolidated env file for the citizen-portal Docker image.
#
# Copy to `.env.local` (gitignored) and tweak as needed:
#   cp apps/citizen-portal/.env.sample apps/citizen-portal/.env.local
#
# Two consumers:
#
#   1) `pnpm docker:run:citizen-portal:local --env-file apps/citizen-portal/.env.local`
#      Runtime-only flags (e.g. PORT, OTEL_*, *_HOST). For the :local image, most
#      NEXT_PUBLIC_* values are already baked in with the Dockerfile.local defaults
#      and will NOT be reapplied at runtime — the static export is immutable.
#
#   2) Future `docker build --build-arg KEY=VALUE` invocations of the production
#      Dockerfile. Pipeline-variables (pipeline-variables/*.yml) feed the same set
#      of ARGs in CI; this file mirrors them for local production-shaped builds.

# --- Cross-zone host URLs (browser-facing, baked into the JS bundles at build time)
NEXT_PUBLIC_CITIZEN_PORTAL_BASE_URL=http://messaging.local.test:8080
NEXT_PUBLIC_SAG_URL=http://sag.local.test:3333
NEXT_PUBLIC_PROFILE_SERVICE_ENTRY_POINT=http://profile.local.test:8080
NEXT_PUBLIC_MESSAGING_ADMIN_SERVICE_ENTRY_POINT=http://localhost:3022
NEXT_PUBLIC_DASHBOARD_SERVICE_ENTRY_POINT=http://dashboard.local.test:8080

# --- Observability (Faro / OTEL)
NEXT_PUBLIC_FARO_URL=
NEXT_PUBLIC_FARO_SERVICE_NAME=citizen-portal
NEXT_PUBLIC_FARO_SERVICE_NAMESPACE=citizen-portal
NEXT_PUBLIC_FARO_PROPAGATE_TRACE_HEADER=http://messaging.local.test:8080/*

OTEL_ENABLE=false
OTEL_SERVICE_NAME=citizen-portal
OTEL_COLLECTOR_URL=

# --- Feature flags
NEXT_PUBLIC_UNLEASH_URL=http://localhost:4242/api/frontend
NEXT_PUBLIC_UNLEASH_CLIENT_KEY=default:development.unleash-insecure-frontend-api-token
NEXT_PUBLIC_UNLEASH_APP_NAME=citizen-portal

# --- Analytics (Matomo)
# Disabled by default for local runs; flip these to enable the client tracker.
NEXT_PUBLIC_MATOMO_URL=//analytics.ogcio.gov.ie
NEXT_PUBLIC_MATOMO_PROTOCOL=https
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
NEXT_PUBLIC_ANALYTICS_ORGANIZATION_ID=ogcio
NEXT_PUBLIC_ANALYTICS_DRY_RUN=true

# Nginx-side analytics proxy (build-time only — embedded into nginx.conf via envsubst)
ANALYTICS_MANAGEMENT_API_ORIGIN=http://localhost:8075
ANALYTICS_MANAGEMENT_API_HOST=localhost:8075
ANALYTICS_TRACKER_ORIGIN=https://track.analytics.dev.services.gov.ie

# --- nginx Host-based routing (build-time for the production Dockerfile; the
# :local image hard-codes these defaults). Match whatever hostnames your client
# resolves to the container (see /etc/hosts or docker --add-host).
MESSAGING_HOST=messaging.local.test
PROFILE_HOST=profile.local.test
DASHBOARD_HOST=dashboard.local.test

# --- Runtime
PORT=8080
TRUSTED_PROXY_CIDR=0.0.0.0/0
