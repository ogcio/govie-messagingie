{
  "name": "@ogcio/govie-services-messaging",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "description": "",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:api:upload\" \"pnpm dev:api:scheduler\" \"pnpm dev:api:profile\" \"pnpm dev:citizen-portal\" \"pnpm dev:admin-next\"",
    "dev:apis": "concurrently \"pnpm dev:api\" \"pnpm dev:api:upload\" \"pnpm dev:api:scheduler\" \"pnpm dev:api:profile\"",
    "dev:api": "pnpm --filter messaging-api dev 2>&1 | tee logs/messaging-api.log",
    "dev:api:upload": "pnpm --filter upload-api dev",
    "dev:api:scheduler": "pnpm --filter scheduler-api dev",
    "dev:api:profile": "pnpm --filter profile-api dev",
    "dev:citizen-portal": "pnpm --filter citizen-portal dev",
    "dev:admin-next": "pnpm --filter messaging-admin-next dev 2>&1 | tee logs/dev-admin-next.log",
    "dev:messaging-next": "pnpm --filter messaging-next dev 2>&1 | tee logs/dev-messaging-next.log",
    "dev:support": "pnpm --filter superadmin dev",
    "dev:setup": "node scripts/dev/setup.mjs",
    "dev:health": "node scripts/dev/health-check.mjs",
    "dev:reset": "pnpm clean && pnpm dev:setup",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter messaging-api build",
    "build:next": "pnpm --filter messaging-next build",
    "build:admin-next": "pnpm --filter messaging-admin-next build",
    "build:citizen-portal": "pnpm --filter citizen-portal -r build",
    "build:upload-api": "pnpm --filter upload-api build",
    "build:scheduler-api": "pnpm --filter scheduler-api build",
    "build:profile-api": "pnpm --filter profile-api build",
    "format": "pnpm -r format",
    "format:api": "pnpm --filter messaging-api format",
    "format:next": "pnpm --filter messaging-next format",
    "format:admin-next": "pnpm --filter messaging-admin-next format",
    "lint": "pnpm -r lint",
    "lint:api": "pnpm --filter messaging-api lint",
    "lint:next": "pnpm --filter messaging-next lint",
    "lint:admin-next": "pnpm --filter messaging-admin-next lint",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter messaging-api test",
    "test:next": "pnpm --filter messaging-next test",
    "test:admin-next": "pnpm --filter messaging-admin-next test",
    "prepare": "husky || true",
    "preinstall": "npx only-allow pnpm",
    "db:up": "docker compose --env-file .env -f docker-compose.yaml up --detach",
    "db:migrate": "pnpm --filter messaging-api db:migrate",
    "db:migrate:upload-api": "pnpm --filter upload-api migrate",
    "db:migrate:scheduler-api": "pnpm --filter scheduler-api migrate",
    "db:migrate:profile-api": "pnpm --filter profile-api db:migrate",
    "db:prepare": "pnpm db:up && pnpm --filter messaging-api db:create && pnpm --filter messaging-api db:migrate && pnpm --filter messaging-api sync-event-summary",
    "db:reset": "node scripts/db/reset.mjs",
    "db:seed": "pnpm --filter messaging-api db:seed",
    "db:reset:seed": "pnpm db:reset --seed",
    "env:init": "node scripts/init-env.mjs",
    "env:update": "MODE=update node scripts/init-env.mjs",
    "env:sync": "MODE=update node scripts/init-env.mjs",
    "env:dry-run": "node scripts/init-env.mjs --dry-run",
    "azure:local": "node scripts/dev/azure-pipeline-local.mjs",
    "pipeline:local": "node scripts/dev/pipeline-local.mjs",
    "docker:build": "pnpm docker:build:base && pnpm docker:build:api && pnpm docker:build:next && pnpm docker:build:admin-next",
    "docker:build:base": "docker build -f Dockerfile -t base-deps .",
    "docker:build:api": "docker build -f apps/messaging-api/Dockerfile -t messaging-api .",
    "docker:build:next": "docker build -f apps/messaging-next/Dockerfile -t messaging-next .",
    "docker:build:admin-next": "docker build -f apps/messaging-admin-next/Dockerfile -t messaging-admin-next .",
    "docker:build:citizen-portal": "docker build -f apps/citizen-portal/Dockerfile -t citizen-portal .",
    "docker:build:citizen-portal:local": "docker build -f apps/citizen-portal/Dockerfile.local -t citizen-portal:local .",
    "docker:build:upload-api:local": "docker build -f apps/upload-api/Dockerfile.local -t upload-api:local .",
    "docker:build:scheduler-api:local": "docker build -f apps/scheduler-api/Dockerfile.local -t scheduler-api:local .",
    "docker:build:profile-api:local": "docker build -f apps/profile-api/Dockerfile.local -t profile-api:local .",
    "docker:run:citizen-portal": "node scripts/dev/docker-run-citizen-portal.mjs --image citizen-portal",
    "docker:run:citizen-portal:local": "node scripts/dev/docker-run-citizen-portal.mjs --image citizen-portal:local",
    "docker:up:citizen-portal:local": "node scripts/dev/docker-run-citizen-portal.mjs --image citizen-portal:local --build",
    "run:dev": "pnpm dev:setup && pnpm dev",
    "deps:smart-update": "tsx scripts/smart-workspace-update.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.10",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "husky": "9.1.7",
    "nodemon": "3.1.14",
    "tsc-alias": "1.9.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  },
  "resolutions": {
    "mdast-util-gfm-autolink-literal": "2.0.1"
  }
}
